{
  "name": "nos2x-auto-approver",
  "version": "0.1.0",
  "description": "Developer-focused nos2x fork with configurable unattended approvals",
  "private": true,
  "license": "WTFPL",
  "scripts": {
    "build": "node build.js prod",
    "check": "bun run lint && bun run test && bun run build && bun run package",
    "lint": "eslint extension tests scripts --ext .js,.jsx,.mjs",
    "package": "node scripts/package.mjs",
    "release:check": "node scripts/check-release-tag.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "async-mutex": "^0.3.2",
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0",
    "eslint-plugin-babel": "^5.3.1",
    "eslint-plugin-react": "^7.28.0",
    "events": "^3.3.0",
    "nostr-tools": "2.12.0",
    "prettier": "^2.5.1",
    "qrcode-parser": "^2.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-qr-code": "^2.0.11",
    "use-debounce": "^7.0.1",
    "webextension-polyfill": "^0.8.0"
  }
}
